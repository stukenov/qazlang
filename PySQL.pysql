вставить в заказы (клиент, продукт, сумма) значения ((выбрать 'клиент' из клиенты), (выбрать 'продукт' из продукты), (выбрать СУММ(цена) из продукты где продукт = 'продукт'));
кнопка 'добавить заказ с суммой';

обновить заказы установить статус = (выбрать 'статус' из статусы), сумма = сумма * (выбрать КУРС(валюта) из курсы валют) где клиент = (выбрать 'клиент' из клиенты);
кнопка 'обновить заказ и сумму';

выбрать имя, продукт, СРЗНАЧ(сумма) из заказы объеденить клиенты в заказы.клиент = клиенты.номер где клиенты.имя = (выбрать 'имя клиента' из клиенты);
кнопка 'показать среднюю сумму заказов клиента';

создать таблицу финансы (номер авто, клиент, доход, расход, прибыль как (доход - расход), (клиент) связан клиенты(номер));
кнопка 'создать таблицу финансов';

обновить финансы установить доход = (выбрать СУММ(сумма) из заказы где клиент = финансы.клиент), расход = (выбрать СУММ(расход) из расходы где клиент = финансы.клиент);
кнопка 'обновить финансы';

создать процедуру расчетприбыли (входной_параметр номер_клиента int) начать выбрать прибыль из финансы где клиент = номер_клиента вывести 'прибыль клиента: ', прибыль конец;
кнопка 'рассчитать прибыль клиента';

удалить из заказы где номер = (выбрать 'номер заказа' из заказы) и статус = 'отменен';
кнопка 'удалить отмененный заказ';

создать процедуру обновитьбаланс (входной_параметр номер_клиента int) начать обновить финансы установить доход = (выбрать СУММ(сумма) из заказы где клиент = номер_клиента), расход = (выбрать СУММ(расход) из расходы где клиент = номер_клиента) вывести 'баланс обновлен.' конец;
кнопка 'обновить баланс клиента';
