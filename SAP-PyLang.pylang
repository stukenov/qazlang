СОЗДАТЬ МАТЕРИАЛ название_материала
    ОПИСАНИЕ "Описание материала" 
    ТИП "Тип материала" 
    ЦЕНА "Цена материала";

ОБНОВИТЬ МАТЕРИАЛ название_материала
УСТАНОВИТЬ 
    ЦЕНА = ЦЕНА * (ВЫБРАТЬ КУРС(валюта) ИЗ курсы валют) 
ГДЕ НАИМЕНОВАНИЕ = название_материала;

ВЫБРАТЬ название, ТИП, СРЗНАЧ(ЦЕНА)
ИЗ МАТЕРИАЛЫ
ГДЕ ТИП = (ВЫБРАТЬ 'тип материала' ИЗ ТИПЫ_МАТЕРИАЛОВ);

СОЗДАТЬ ТАБЛИЦУ склад
СТОЛБЦЫ
    номер_партии, название_материала, количество, цена_закупки, 
    цена_продажи КАК (цена_закупки * (ВЫБРАТЬ КУРС(валюта) ИЗ курсы валют)), 
    (название_материала) СВЯЗАН МАТЕРИАЛЫ(название);

ОБНОВИТЬ склад
УСТАНОВИТЬ 
    количество = (ВЫБРАТЬ СУММ(количество) ИЗ поставки ГДЕ название_материала = склад.название_материала), 
    цена_закупки = (ВЫБРАТЬ СУММ(цена) ИЗ поставки ГДЕ название_материала = склад.название_материала);

СОЗДАТЬ ПРОЦЕДУРУ расчетцены (название_материала TEXT)
НАЧАТЬ 
    ВЫБРАТЬ цена_продажи ИЗ склад ГДЕ название_материала = название_материала 
    ВЫВЕСТИ 'цена продажи материала: ', цена_продажи 
КОНЕЦ;

УДАЛИТЬ ИЗ МАТЕРИАЛЫ
ГДЕ название = (ВЫБРАТЬ 'название материала' ИЗ МАТЕРИАЛЫ) 
    И ТИП = 'устаревший';

СОЗДАТЬ ПРОЦЕДУРУ обновитьцены (название_материала TEXT)
НАЧАТЬ 
    ОБНОВИТЬ склад 
    УСТАНОВИТЬ 
        цена_закупки = (ВЫБРАТЬ СУММ(цена) ИЗ поставки ГДЕ название_материала = название_материала), 
        количество = (ВЫБРАТЬ СУММ(количество) ИЗ поставки ГДЕ название_материала = название_материала) 
    ВЫВЕСТИ 'цены обновлены.' 
КОНЕЦ;

СОЗДАТЬ СТРАНИЦУ управлениематериалами
    ЗАГОЛОВОК "Управление материалами" 
    ОПИСАНИЕ "Страница для управления материалами на складе";

СОЗДАТЬ ФОРМУ добавитьматериал НА-СТРАНИЦЕ управлениематериалами
    ПОЛЕ ВВОДА "название_материала" ТИП: текст МЕТКА: "Введите название материала" ОБЯЗАТЕЛЬНОЕ: да 
    КНОПКА "добавить" ДЕЙСТВИЕ: добавитьМатериал;

СОЗДАТЬ ТАБЛИЦУ ценыматериалов НА-СТРАНИЦЕ управлениематериалами
    СТОЛБЕЦ "название_материала" ТИП: текст ЗАГОЛОВОК: "Название материала" 
    СТОЛБЕЦ "цена_продажи" ТИП: число ЗАГОЛОВОК: "Цена продажи";

СОЗДАТЬ ВЫПАДАЮЩИЙ-СПИСОК типыматериалов НА-ФОРМЕ добавитьматериал
    ОПЦИЯ "тип1" С ТЕКСТОМ "Тип материала 1" 
    ОПЦИЯ "тип2" С ТЕКСТОМ "Тип материала 2";

СОЗДАТЬ СЛАЙДЕР выборцены НА-СТРАНИЦЕ управлениематериалами
    МИНИМУМ(0) МАКСИМУМ(10000) ШАГ(100);



