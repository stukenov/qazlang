
ВСТАВИТЬ В заказы (клиент, продукт, сумма)
    ЗНАЧЕНИЯ (
        (ВЫБРАТЬ 'клиент' ИЗ клиенты), 
        (ВЫБРАТЬ 'продукт' ИЗ продукты), 
        (ВЫБРАТЬ СУММ(цена) ИЗ продукты ГДЕ продукт = 'продукт')
    );

ОБНОВИТЬ заказы
УСТАНОВИТЬ 
    статус = (ВЫБРАТЬ 'статус' ИЗ статусы), 
    сумма = сумма * (ВЫБРАТЬ КУРС(валюта) ИЗ курсы валют) 
ГДЕ клиент = (ВЫБРАТЬ 'клиент' ИЗ клиенты);

ВЫБРАТЬ имя, продукт, СРЗНАЧ(сумма)
ИЗ заказы
ОБЪЕДИНИТЬ клиенты ПО заказы.клиент = клиенты.номер
ГДЕ клиенты.имя = (ВЫБРАТЬ 'имя клиента' ИЗ клиенты);

СОЗДАТЬ ТАБЛИЦУ финансы
СТОЛБЦЫ
    номер авто, клиент, доход, расход, 
    прибыль КАК (доход - расход), 
    (клиент) СВЯЗАН клиенты(номер);

ОБНОВИТЬ финансы
УСТАНОВИТЬ 
    доход = (ВЫБРАТЬ СУММ(сумма) ИЗ заказы ГДЕ клиент = финансы.клиент), 
    расход = (ВЫБРАТЬ СУММ(расход) ИЗ расходы ГДЕ клиент = финансы.клиент);

СОЗДАТЬ ПРОЦЕДУРУ расчетприбыли (номер_клиента INT)
НАЧАТЬ 
    ВЫБРАТЬ прибыль ИЗ финансы ГДЕ клиент = номер_клиента 
    ВЫВЕСТИ 'прибыль клиента: ', прибыль 
КОНЕЦ;

УДАЛИТЬ ИЗ заказы
ГДЕ номер = (ВЫБРАТЬ 'номер заказа' ИЗ заказы) 
    И статус = 'отменен';

СОЗДАТЬ ПРОЦЕДУРУ обновитьбаланс (номер_клиента INT)
НАЧАТЬ 
    ОБНОВИТЬ финансы 
    УСТАНОВИТЬ 
        доход = (ВЫБРАТЬ СУММ(сумма) ИЗ заказы ГДЕ клиент = номер_клиента), 
        расход = (ВЫБРАТЬ СУММ(расход) ИЗ расходы ГДЕ клиент = номер_клиента) 
    ВЫВЕСТИ 'баланс обновлен.' 
КОНЕЦ;

СОЗДАТЬ СТРАНИЦУ название_страницы
    ЗАГОЛОВОК "Название страницы" 
    ОПИСАНИЕ "Краткое описание страницы";

СОЗДАТЬ ФОРМУ название_формы НА-СТРАНИЦЕ название_страницы
    ПОЛЕ ВВОДА "имя_поля" ТИП: текст МЕТКА: "Введите ваше имя" ОБЯЗАТЕЛЬНОЕ: да 
    КНОПКА "отправить" ДЕЙСТВИЕ: отправитьФорму;

СОЗДАТЬ ТАБЛИЦУ название_таблицы НА-СТРАНИЦЕ название_страницы
    СТОЛБЕЦ "имя_столбца1" ТИП: текст ЗАГОЛОВОК: "Название столбца" 
    СТОЛБЕЦ "имя_столбца2" ТИП: число ЗАГОЛОВОК: "Количество";

СОЗДАТЬ ВЫПАДАЮЩИЙ-СПИСОК название_списка НА-ФОРМЕ название_формы
    ОПЦИЯ "значение1" С ТЕКСТОМ "Отображаемый текст 1" 
    ОПЦИЯ "значение2" С ТЕКСТОМ "Отображаемый текст 2";

СОЗДАТЬ СЛАЙДЕР название_слайдера НА-СТРАНИЦЕ название_страницы
    МИНИМУМ(0) МАКСИМУМ(100) ШАГ(5);



